{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pilates",
      "destination": "/fitness-wellness",
      "permanent": true
    },
    {
      "source": "/nutritional-health",
      "destination": "/fitness-wellness",
      "permanent": true
    },
    {
      "source": "/rock-steady-boxing",
      "destination": "/parkinsons-rehab",
      "permanent": true
    },
    {
      "source": "/lake-oswego",
      "destination": "/locations",
      "permanent": true
    }
  ]
}
